# Cloud model settings (copy values into .env; never commit a real key).
MODEL_PROVIDER=deepseek
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
MODEL_API_KEY=REPLACE_WITH_YOUR_KEY

# Execution infrastructure. These non-secret defaults also live in .env.runtime.
AGENT_TEAM_EXECUTION_MODE=redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=agent-team
REDIS_WORKER_GROUP=agent-team-workers
REDIS_LEASE_SECONDS=30
REDIS_RECLAIM_IDLE_MS=45000
REDIS_MAX_AUTO_RECOVERIES=5
REDIS_WORKER_CONCURRENCY=4
