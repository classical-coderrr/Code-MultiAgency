# Non-secret execution infrastructure settings.
# Copy this file to .env.runtime when Redis Worker mode is needed.
AGENT_TEAM_EXECUTION_MODE=redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=agent-team
REDIS_WORKER_GROUP=agent-team-workers
REDIS_LEASE_SECONDS=30
REDIS_RECLAIM_IDLE_MS=45000
REDIS_MAX_AUTO_RECOVERIES=5
REDIS_WORKER_CONCURRENCY=4
